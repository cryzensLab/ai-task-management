# Copy this file to .env (next to server.js) and restart the server.
# .env is git-ignored and never served to browsers.

# --- Prompt Studio AI assistant (optional) ---------------------------------
# Without a key, Prompt Studio uses its built-in matcher and wording.
# Get a key at https://aistudio.google.com/apikey
# Free tier: Google may use prompts to improve its products and human reviewers
# may read them. Do not send personal or confidential information. Teams in
# the EEA, Switzerland or the UK must use a paid plan.
GEMINI_API_KEY=

# Stable model with a free tier. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Local request budget. Real free-tier limits are shown in AI Studio and can change.
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_DAY=100
AI_TIMEOUT_MS=20000

# Provider name; only "gemini" exists today.
AI_PROVIDER=gemini
